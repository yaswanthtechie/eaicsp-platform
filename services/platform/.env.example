# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace_with_a_long_random_value
# Optional. Set to true only when running behind a trusted reverse proxy
# that populates X-Forwarded-For.
TRUST_PROXY=false
DATABASE_URL=sqlite:///./platform.db
# Seed user passwords. Required only when running `python -m app.seed`.
CEO_PASSWORD=
VP_OPERATIONS_PASSWORD=
PROCUREMENT_MANAGER_PASSWORD=
LOGISTICS_MANAGER_PASSWORD=
COMPLIANCE_OFFICER_PASSWORD=
WAREHOUSE_MANAGER_PASSWORD=
ANALYST_PASSWORD=
SUPPLIER_PASSWORD=

BASE_URL=http://127.0.0.1:8005

# Access token used by the /verify load test
ACCESS_TOKEN=your_real_access_token_here

# Load-test configuration
TOTAL_REQUESTS=150
CONCURRENCY=20
TIMEOUT_SECONDS=10
