# Inventory Service environment variables

# Copy this file to .env and fill in real values. Never commit .env.

DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/inventory

TEST_DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/inventory_test

PLATFORM_AUTH_URL=http://localhost:8005

# Compliance Service (see services/api-gateway SERVICE_ROUTES)
COMPLIANCE_SERVICE_URL=http://localhost:8003

# POs with expected_cost above this need vp_operations approval
PO_AUTO_APPROVAL_THRESHOLD=1000

DEFAULT_SUPPLIER_COUNTRY=India

NETWORK_SERVICE_LEVEL_Z=1.65

# Forecast contract (not wired yet)
FORECAST_MAX_AGE_DAYS=35