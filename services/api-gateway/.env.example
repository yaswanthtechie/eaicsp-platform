# API Gateway Environment Configuration Example

# Application Settings
APP_NAME="API Gateway"
VERSION="1.0.0"
DEBUG=False
LOAD_TEST_MODE=False

# HTTP Client Settings
TIMEOUT_SECONDS=5
MAX_RETRIES=2

# Security & JWT Settings
JWT_SECRET="super-secret-key-change-in-production"
JWT_ALGORITHM="HS256"

# Rate Limiting & Proxy Trust
# List trusted reverse proxy IP addresses (e.g., ["10.0.0.1", "172.16.0.1"])
# Default is empty: X-Forwarded-For is ignored unless request peer IP is in TRUSTED_PROXIES
TRUSTED_PROXIES=[]
RATE_LIMIT_WINDOW_SECONDS=60

# Circuit Breaker Settings
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=10.0