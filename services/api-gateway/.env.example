# API Gateway Environment Configuration Example

# Application Settings
APP_NAME="API Gateway"
VERSION="1.0.0"
DEBUG=False

# HTTP Client Settings
TIMEOUT_SECONDS=5
MAX_RETRIES=2

# Security & JWT Settings
# SECRET_KEY is REQUIRED - must match the platform token issuer SECRET_KEY exactly
SECRET_KEY=""
JWT_ALGORITHM="HS256"

# Rate Limiting & Proxy Trust
# List trusted reverse proxy IP addresses (e.g., ["10.0.0.1", "172.16.0.1"])
# Default is empty: X-Forwarded-For is ignored unless request peer IP is in TRUSTED_PROXIES
TRUSTED_PROXIES=[]
RATE_LIMIT_WINDOW_SECONDS=60

# Circuit Breaker Settings
CIRCUIT_BREAKER_FAILURE_RATE_THRESHOLD=0.50
CIRCUIT_BREAKER_WINDOW_SECONDS=60
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30.0

# Downstream Service URLs
PLATFORM_SERVICE_URL="http://localhost:8005"
INVENTORY_SERVICE_URL="http://localhost:8001"
SHIPMENTS_SERVICE_URL="http://localhost:8002"
COMPLIANCE_SERVICE_URL="http://localhost:8003"
PURCHASE_ORDERS_SERVICE_URL="http://localhost:8004"
SUPPLIER_RISK_SERVICE_URL="http://localhost:8006"

# Service-to-Service Authentication
API_GATEWAY_SERVICE_API_KEY=""

# Round 10 Milestone 2 - OpenTelemetry / Jaeger
OTEL_ENABLED=true
OTEL_SERVICE_NAME=api-gateway
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Grafana admin (docker-compose.dev.yml). Set real values in .env only.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
# Grafana anonymous viewer access (opt-in for local dev, default false)
GRAFANA_ANON=false

# Load testing only: disables rate limiting. Never set in a deployed environment.
LOAD_TEST_MODE=false

# Prometheus scrape endpoint bearer token
METRICS_BEARER_TOKEN=""

# Set to true for local dev only. When false (the default), /metrics refuses
# to serve unless METRICS_BEARER_TOKEN is set.
METRICS_ALLOW_ANONYMOUS=false
