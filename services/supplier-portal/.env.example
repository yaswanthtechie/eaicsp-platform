# Platform Service (authentication provider)
PLATFORM_AUTH_URL=http://127.0.0.1:8005

# Compliance Service (supplier screening before activation)
COMPLIANCE_SERVICE_URL=http://127.0.0.1:8003

# MinIO object storage
# Used by the app and docker-compose.dev.yml.
# Replace these placeholders with local development credentials in .env.
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me-at-least-8-chars
MINIO_BUCKET=supplier-documents
MINIO_SECURE=false
MINIO_PRESIGNED_EXPIRY_SECONDS=300

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=supplier-portal-service
KAFKA_STATUS_CHANGED_TOPIC=compliance.supplier.status_changed
KAFKA_DLQ_TOPIC=compliance.supplier.status_changed.dlq
KAFKA_AUTO_OFFSET_RESET=earliest

# Kafka Consumer Reliability
KAFKA_ENABLED=true
KAFKA_RETRY_BACKOFF_SECONDS=1.0
KAFKA_MAX_RETRIES=5

# Durable Compliance State (SQLite)
COMPLIANCE_DB_PATH=data/compliance_state.db
