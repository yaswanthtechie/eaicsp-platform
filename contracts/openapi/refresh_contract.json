{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PlatformAccessTokenResponse",
  "description": "Contract for Platform Service /api/v1/auth/refresh response",
  "type": "object",
  "required": [
    "access_token",
    "refresh_token",
    "token_type"
  ],
  "properties": {
    "access_token": {
      "type": "string",
      "description": "Short-lived JWT access token"
    },
    "refresh_token": {
      "type": "string",
      "description": "Rotated JWT refresh token in the same token family"
    },
    "token_type": {
      "type": "string",
      "description": "Authorization token type",
      "enum": [
        "bearer"
      ]
    }
  }
}