{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eaicsp.platform/contracts/events/inventory.po.approved.v1.json",
  "title": "InventoryPOApprovedEvent",
  "description": "Event emitted by Inventory Service when a Purchase Order is approved by a procurement manager, notifying Supplier Portal to mirror the PO.",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "producer",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique UUID v4 for idempotency tracking."
    },
    "event_type": {
      "type": "string",
      "const": "inventory.po.approved",
      "description": "Event type identifier."
    },
    "event_version": {
      "type": "integer",
      "const": 1,
      "description": "Schema version number (integer 1)."
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC ISO-8601 timestamp when the PO approval occurred."
    },
    "producer": {
      "type": "string",
      "const": "inventory-service",
      "description": "Originating service."
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Distributed tracing correlation identifier."
    },
    "payload": {
      "type": "object",
      "required": [
        "po_id",
        "supplier_id",
        "warehouse_id",
        "approval_status",
        "approved_by",
        "approved_at",
        "total_amount",
        "lines"
      ],
      "properties": {
        "po_id": {
          "type": "string",
          "pattern": "^PO-\\d{4}-\\d{6}$",
          "description": "Canonical Purchase Order ID (e.g. PO-2026-000123)."
        },
        "po_number": {
          "type": "string",
          "description": "Purchase Order reference number for supplier portal mirror."
        },
        "supplier_id": {
          "type": "string",
          "pattern": "^SUP-\\d{5}$",
          "description": "Canonical Supplier ID (e.g. SUP-00045)."
        },
        "warehouse_id": {
          "type": "string",
          "pattern": "^WH-[A-Z]{3}-\\d{2}$",
          "description": "Canonical Destination Warehouse ID (e.g. WH-BLR-01)."
        },
        "approval_status": {
          "type": "string",
          "enum": [
            "approved"
          ],
          "description": "Approval workflow state."
        },
        "approved_by": {
          "type": "string",
          "minLength": 1,
          "description": "Platform user ID of the approver, from the auth token's user_id (stringified). 'system' for auto-approved POs."
        },
        "approved_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC ISO-8601 timestamp of approval."
        },
        "total_amount": {
          "type": "number",
          "minimum": 0,
          "description": "Total expected purchase order value."
        },
        "currency": {
          "type": "string",
          "default": "INR",
          "description": "Currency code (e.g. INR, USD)."
        },
        "expected_delivery_date": {
          "type": "string",
          "format": "date",
          "description": "Target delivery date (YYYY-MM-DD)."
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "description": "Ordered line items on the purchase order.",
          "items": {
            "type": "object",
            "required": [
              "line_number",
              "sku_id",
              "quantity",
              "unit_cost",
              "expected_cost"
            ],
            "properties": {
              "line_number": {
                "type": "integer",
                "minimum": 1,
                "description": "1-based line sequence number."
              },
              "sku_id": {
                "type": "string",
                "pattern": "^SKU-\\d{6}$",
                "description": "Canonical Product / SKU ID (e.g. SKU-000123)."
              },
              "quantity": {
                "type": "integer",
                "minimum": 1,
                "description": "Quantity of units ordered."
              },
              "unit_cost": {
                "type": "number",
                "minimum": 0,
                "description": "Unit purchase price."
              },
              "expected_cost": {
                "type": "number",
                "minimum": 0,
                "description": "Total line cost (quantity * unit_cost)."
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
