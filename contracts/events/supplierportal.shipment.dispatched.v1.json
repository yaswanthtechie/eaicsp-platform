{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Supplier Portal Shipment Dispatched Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "producer",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "event_type": {
      "const": "supplierportal.shipment.dispatched"
    },
    "event_version": {
      "type": "integer",
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "const": "supplier-portal"
    },
    "trace_id": {
      "type": ["string", "null"],
      "description": "Optional distributed trace id."
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shipment_id",
        "po_number",
        "supplier_id",
        "origin",
        "destination_warehouse",
        "carrier",
        "dispatched_at"
      ],
      "properties": {
        "shipment_id": {
          "type": "string",
          "pattern": "^SHP-[0-9]{4}-[0-9]{6}$"
        },
        "po_number": {
          "type": "string",
          "pattern": "^PO-[0-9]{4}-[0-9]{6}$"
        },
        "supplier_id": {
          "type": "string",
          "pattern": "^SUP-[0-9]{5}$"
        },
        "origin": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "destination_warehouse": {
          "type": "string",
          "pattern": "^WH-[A-Z]{3}-[0-9]{2}$"
        },
        "carrier": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "dispatched_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}