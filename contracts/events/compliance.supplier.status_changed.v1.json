{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://eaicsp.internal/contracts/events/compliance.supplier.status_changed.v1.json",
  "title": "compliance.supplier.status_changed",
  "description": "Emitted by the Compliance service when a supplier's internal screening status is updated.",
  "type": "object",
  "allOf": [
    { "$ref": "envelope.v1.json" },
    {
      "properties": {
        "event_type": { "const": "compliance.supplier.status_changed" },
        "data": {
          "type": "object",
          "properties": {
            "supplier_id": {
              "type": "string",
              "pattern": "^SUP-\\d{5}$",
              "description": "Supplier canonical ID format."
            },
            "previous_status": {
              "type": "string",
              "enum": ["UNSCREENED", "PENDING", "APPROVED", "REJECTED", "SUSPENDED"]
            },
            "new_status": {
              "type": "string",
              "enum": ["UNSCREENED", "PENDING", "APPROVED", "REJECTED", "SUSPENDED"]
            },
            "reason": {
              "type": "string",
              "description": "Context for the status change (e.g., sanctions match)."
            }
          },
          "required": ["supplier_id", "previous_status", "new_status"],
          "additionalProperties": false
        }
      }
    }
  ]
}