{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eaicsp.platform/contracts/events/inventory.goods.received.v1.json",
  "title": "InventoryGoodsReceivedEvent",
  "description": "Event emitted by Inventory Service when goods physically arrive at a warehouse against a PO, notifying Supplier Portal for 3-way matching.",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "producer",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique UUID v4 for idempotency tracking."
    },
    "event_type": {
      "type": "string",
      "const": "inventory.goods.received",
      "description": "Event type identifier."
    },
    "event_version": {
      "type": "integer",
      "const": 1,
      "description": "Schema version number (integer 1)."
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC ISO-8601 timestamp when goods were received."
    },
    "producer": {
      "type": "string",
      "const": "inventory-service",
      "description": "Originating service."
    },
    "trace_id": {
      "type": "string",
      "description": "Distributed tracing correlation identifier."
    },
    "payload": {
      "type": "object",
      "required": [
        "receipt_id",
        "po_id",
        "supplier_id",
        "warehouse_id",
        "received_by",
        "received_at",
        "status",
        "items"
      ],
      "properties": {
        "receipt_id": {
          "type": "string",
          "pattern": "^GR-\\d{4}-\\d{6}$",
          "description": "Canonical Goods Receipt ID (e.g. GR-2026-000077)."
        },
        "po_id": {
          "type": "string",
          "pattern": "^PO-\\d{4}-\\d{6}$",
          "description": "Associated Purchase Order ID (e.g. PO-2026-000123)."
        },
        "po_number": {
          "type": "string",
          "description": "Associated Purchase Order reference number."
        },
        "supplier_id": {
          "type": "string",
          "pattern": "^SUP-\\d{5}$",
          "description": "Canonical Supplier ID (e.g. SUP-00045)."
        },
        "warehouse_id": {
          "type": "string",
          "pattern": "^WH-[A-Z]{3}-\\d{2}$",
          "description": "Destination Warehouse ID where goods arrived (e.g. WH-BLR-01)."
        },
        "received_by": {
          "type": "string",
          "description": "Username or email of the warehouse receiver."
        },
        "received_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC ISO-8601 timestamp of physical receipt."
        },
        "status": {
          "type": "string",
          "enum": ["received"],
          "description": "Goods receipt processing status."
        },
        "notes": {
          "type": "string",
          "description": "Optional receiver remarks or shipment condition notes."
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "description": "Received line items.",
          "items": {
            "type": "object",
            "required": [
              "sku_id",
              "quantity_received"
            ],
            "properties": {
              "sku_id": {
                "type": "string",
                "pattern": "^SKU-\\d{6}$",
                "description": "Canonical Product / SKU ID (e.g. SKU-000123)."
              },
              "quantity_received": {
                "type": "integer",
                "minimum": 1,
                "description": "Quantity physically verified and received into inventory."
              },
              "unit_cost": {
                "type": "number",
                "minimum": 0,
                "description": "Unit purchase price as received."
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
