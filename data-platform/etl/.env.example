DB_HOST=localhost
DB_PORT=5432
DB_NAME=salesdb
DB_USER=admin
DB_PASSWORD=
AIRFLOW_UID=50000

AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__API__SECRET_KEY=
ETL_ENV=dev

# R12-13 analytics/event infrastructure
CLICKHOUSE_DATABASE=analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# Host-side address of Kafka, used only by pytest integration tests.
KAFKA_HOST_BOOTSTRAP=localhost:9094

# Airflow web UI login. Required by docker compose.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=

# MinIO credentials for MLflow model artifact access
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# R15-U3 nightly forecast batch. Empty values use the ETL stack defaults.
# On the shared stack set these to the infra aliases once Ajith adds them (#230).
CLICKHOUSE_HOST=
KAFKA_BOOTSTRAP_SERVERS=
MLFLOW_TRACKING_URI=
MLFLOW_S3_ENDPOINT_URL=
MLFLOW_MODEL_NAME=demand_forecast
# Required. Use a separate Redis DB from the Celery broker, e.g. redis://infra-redis:6379/1
FORECAST_REDIS_URL=
