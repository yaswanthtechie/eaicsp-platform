# --- Postgres (used by docker-compose.dev.yml AND the library) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=validation_db
# Must match the three values above.
DATABASE_URL=postgresql://:@localhost:5432/validation_db

# --- Kafka streaming consumer ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=validation-group-v1
KAFKA_INPUT_TOPIC=sales.raw
KAFKA_VALID_TOPIC=sales.valid
KAFKA_DLQ_TOPIC=sales.dlq
VALIDATOR_CONFIG=configs/dev/sales_rules.yaml
# Write one streaming run summary to Postgres every N records.
STREAM_PERSIST_EVERY=100

# --- Prometheus ---
METRICS_PORT=8000