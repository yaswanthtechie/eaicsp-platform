# ------------------------------------------------------------------
# Supplier Risk ML Service - Environment Configuration Example
# ------------------------------------------------------------------

# Pretrained HuggingFace sentiment model (default: ProsusAI/finbert)
SUPPLIER_RISK_MODEL_NAME=ProsusAI/finbert

# Sentiment penalties applied to headline scores
NEGATIVE_SENTIMENT_PENALTY=40.0
NEUTRAL_SENTIMENT_PENALTY=0.0
POSITIVE_SENTIMENT_PENALTY=0.0

# Scoring caps and thresholds
MAX_RISK_SCORE=100.0

# Evidence confidence saturation divisor (1 - exp(-n / divisor))
CONFIDENCE_DIVISOR=8.0

# Risk aggregation strategy: top_k_mean, max, blend, or mean
AGGREGATION_STRATEGY=top_k_mean

# Number of top headlines to average under top_k_mean strategy
AGGREGATION_TOP_K=3

# Optional custom keyword weights in JSON format
# SIGNAL_WEIGHTS_JSON={"bankruptcy":50,"fraud":40,"strike":25}
