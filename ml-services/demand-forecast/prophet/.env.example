# Platform Service, used to verify the X-API-Key on GET /api/v1/demand/forecast/{sku_id}
# Local: http://127.0.0.1:8005   Docker: http://platform:8005
PLATFORM_SERVICE_URL=http://127.0.0.1:8005

# MLflow production forecast model (R15-A9)
MLFLOW_MODEL_NAME=demand_forecast
MLFLOW_MODEL_ALIAS=production
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_MODEL_CACHE_DIR=./model_cache
MLFLOW_HTTP_REQUEST_MAX_RETRIES=2
MLFLOW_HTTP_REQUEST_TIMEOUT=10
