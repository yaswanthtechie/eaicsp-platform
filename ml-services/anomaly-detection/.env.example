# Copy to .env (gitignored) and fill in local dev values. Never commit .env.
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=change-me-dev-token
INFLUXDB_PASSWORD=change-me-min-8-chars
INFLUXDB_ORG=eaicsp
INFLUXDB_BUCKET=iot_sensors
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# MLflow tracking for the sales anomaly jobs (R15-K6)
# Where runs are logged. When it is not set, the sales anomaly jobs log
# nothing and print a warning. Never hard-coded. The compose server uses port 5000.
MLFLOW_TRACKING_URI=http://localhost:5000

# The compose MLflow server stores artifacts (the drift report, registered
# models) in MinIO at s3://ml-models, so the client needs these too (boto3 is
# in requirements.txt). Use the same values as MINIO_ROOT_USER and
# MINIO_ROOT_PASSWORD in the root .env.
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=change_me_123

# Optional: how long a run waits for MLflow before giving up. The service sets
# these defaults; override them here if needed.
# MLFLOW_HTTP_REQUEST_MAX_RETRIES=1
# MLFLOW_HTTP_REQUEST_BACKOFF_FACTOR=1
# MLFLOW_HTTP_REQUEST_TIMEOUT=10