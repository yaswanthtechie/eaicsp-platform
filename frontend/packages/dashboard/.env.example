
# Copy to .env (gitignored) and fill in.

# WebSocket URL for live dashboard alerts. Empty = local mock server (ws://localhost:8080).
VITE_ALERTS_WS_URL=

# Live-alerts E2E (npm run test:e2e:alerts / make e2e-alerts).
# Mode: real = gateway + make demo-anomaly, mock = mock server only.
ALERTS_E2E_MODE=real

# Seeded Platform user the test logs in as (services/platform/app/seed.py).
E2E_USERNAME=ceo@company.com
E2E_PASSWORD=

# true = start the in-browser mock WebSocket server (dev only).
VITE_USE_MOCK_WS=true

# true = mocked login; false = real platform login.
VITE_USE_MOCK_AUTH=true

# Leave empty to use the Vite proxy to the platform service on :8005
VITE_AUTH_BASE_URL=

# true = use the contract-shaped KPI mock; false = call the real Gateway BFF
VITE_USE_MOCK_KPIS=true

# Leave empty to use the Vite dev proxy to the API Gateway on :8000
VITE_KPI_API_BASE_URL=
# Only for e2e authentication tests with a running platform service
# Never commit real credentials
TEST_AUTH_USERNAME=
TEST_AUTH_PASSWORD=

