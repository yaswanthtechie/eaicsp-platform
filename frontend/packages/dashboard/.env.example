
# Copy to .env (gitignored) and fill in.

# WebSocket URL for live dashboard alerts; defaults to the local mock server
VITE_ALERTS_WS_URL=

# Enable the Playwright live-alerts E2E test.
# Set to false or leave unset to skip the test.
RUN_LIVE_ALERTS_E2E=true

# E2E mode: mock for simulated alerts, real for the actual backend flow.
ALERTS_E2E_MODE=mock

# Required only when ALERTS_E2E_MODE=real.
# Set locally; never commit a real access token.
E2E_ACCESS_TOKEN=
E2E_REFRESH_TOKEN=your_real_refresh_token

# true = mocked login; false = real platform login
VITE_USE_MOCK_AUTH=true

# Leave empty to use the Vite proxy to the platform service on :8005
VITE_AUTH_BASE_URL=

# true = use the contract-shaped KPI mock; false = call the real Gateway BFF
VITE_USE_MOCK_KPIS=true

# Leave empty to use the Vite dev proxy to the API Gateway on :8000
VITE_KPI_API_BASE_URL=
# Only for e2e authentication tests with a running platform service
# Never commit real credentials
TEST_AUTH_USERNAME=
TEST_AUTH_PASSWORD=

