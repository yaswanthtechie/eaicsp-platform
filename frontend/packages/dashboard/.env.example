
# Copy to .env (gitignored) and fill in.

# true = mocked login; false = real platform login
VITE_USE_MOCK_AUTH=true

# Leave empty to use the Vite proxy to the platform service on :8005
VITE_AUTH_BASE_URL=

# Only for e2e authentication tests with a running platform service
# Never commit real credentials
TEST_AUTH_USERNAME=
TEST_AUTH_PASSWORD=

