# Copy to .env and change every *_PASSWORD / *_TOKEN value. .env is gitignored.

# PostgreSQL (superuser, used only by the init script)
POSTGRES_DB=shared_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# One user per service schema (created by infra/postgres/init-schemas.sh)
INVENTORY_DB_PASSWORD=change_me
SUPPLIER_PORTAL_DB_PASSWORD=change_me
COMPLIANCE_DB_PASSWORD=change_me
PLATFORM_DB_PASSWORD=change_me
LOGISTICS_DB_PASSWORD=change_me
MLFLOW_DB_PASSWORD=change_me

# ClickHouse
CLICKHOUSE_DB=platform_analytics
CLICKHOUSE_USER=analytics_user
CLICKHOUSE_PASSWORD=change_me

# MinIO (min 8 characters for the password)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_123

# InfluxDB
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=change_me_123
INFLUXDB_ORG=eaicsp
INFLUXDB_BUCKET=telemetry
INFLUXDB_ADMIN_TOKEN=change_me_token

# MLflow (host port; container always listens on 5000)
MLFLOW_PORT=5000

# Kafka bootstrap for services running on the host
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
